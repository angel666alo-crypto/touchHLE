+/// Reads the file a file URL points to and returns it as CFData. Only file
+/// URLs are supported; properties are not implemented (NULL is returned).
+fn CFURLCreateDataAndPropertiesFromResource(
+    env: &mut Environment,
+    _allocator: CFAllocatorRef,
+    url: CFURLRef,
+    resource_data: MutPtr<id>,
+    properties: MutPtr<id>,
+    _desired_properties: id,
+    error_code: MutPtr<i32>,
+) -> bool {
+    let path: id = msg![env; url path];
+    let data: id = if path == nil {
+        nil
+    } else {
+        msg_class![env; NSData dataWithContentsOfFile:path]
+    };
+    if !properties.is_null() {
+        env.mem.write(properties, nil);
+    }
+    if data == nil {
+        if !resource_data.is_null() {
+            env.mem.write(resource_data, nil);
+        }
+        if !error_code.is_null() {
+            env.mem.write(error_code, -10); // kCFURLResourceNotFoundError
+        }
+        false
+    } else {
+        // The caller owns the result ("Create" rule), so retain it.
+        let data: id = msg![env; data retain];
+        if !resource_data.is_null() {
+            env.mem.write(resource_data, data);
+        }
+        if !error_code.is_null() {
+            env.mem.write(error_code, 0);
+        }
+        true
+    }
+}
